# Template for the local .env consumed by docker-compose and the loader.
# Exists so credentials stay out of git while the stack still starts from a clean clone.
# Copy to .env and change the password; .env is gitignored, this file is not.

POSTGRES_USER=revenue_ops
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=revenue_anomaly

# Where the loader reaches the container from the host. POSTGRES_PORT also sets the port
# compose publishes on, so one value drives both sides. Change it if a natively installed
# PostgreSQL already owns 5432 on this machine — the container always listens on 5432
# internally regardless.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Day 7 guardrail: the agent's own login, deliberately NOT revenue_ops. It is granted SELECT on
# the analytics schema and INSERT on the audit table and nothing else, so a compromised agent
# cannot write, drop, or reach raw. Create it with `python -m agent.guardrails.provision`.
AGENT_DB_USER=revenue_agent
AGENT_DB_PASSWORD=change_me_locally_too

# Day 9 reporting login: what Power BI Desktop connects as. SELECT on the analytics schema and
# nothing else — tighter than the agent, which also holds INSERT on the audit table. A dashboard
# has nothing to audit, and read access there would show a BI user every query the agent ran.
# Deliberately a distinct login rather than a reuse of revenue_agent: two consumers sharing one
# role makes "who read this?" unanswerable in pg_stat_activity and the server log.
# Create it with `python -m dashboards.provision_reporting --verify`.
REPORTING_DB_USER=revenue_reporting
REPORTING_DB_PASSWORD=change_me_locally_as_well

# Day 8 LLM provider. Groq is the current default because it has a genuinely free tier; the
# Anthropic adapter is still present and working, so LLM_PROVIDER=anthropic switches back with
# no code change. Get a free key at https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here

# Only needed for LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Only needed for LLM_PROVIDER=openai-compatible, i.e. any other OpenAI-shaped endpoint that
# has no named adapter of its own (Together, OpenRouter, a local vLLM).
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY_ENV=MY_PROVIDER_KEY
# LLM_MODEL=some-model-name
