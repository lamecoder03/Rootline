# Pins line endings per file type so a clone works regardless of the user's autocrlf setting.
# Exists because cmd.exe silently mis-parses a .bat file that has LF endings — it eats the
# leading characters of each line — which would break run_dbt.bat on a fresh clone.
# Batch files are forced to CRLF; SQL, YAML and docs are normalised to LF in the repo.

* text=auto

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts run inside Linux containers and MUST be LF: a CRLF shebang line makes the
# kernel look for an interpreter named "/usr/bin/env bash", which fails as "no such file".
*.sh  text eol=lf

*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py  text eol=lf
*.md  text eol=lf
*.csv text eol=lf
